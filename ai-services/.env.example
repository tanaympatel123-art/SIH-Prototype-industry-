# AI Microservice Environment Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# AI Provider Mode: "mock" | "openai" | "groq" | "ollama"
AI_PROVIDER=mock

# Timeout setting in milliseconds (Internal circuit breaker limit for Python service)
AI_SERVICE_TIMEOUT_MS=2500

# Provider API Keys & Settings (Optional if AI_PROVIDER=mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
