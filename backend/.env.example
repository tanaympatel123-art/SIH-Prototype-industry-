# ─── Database (MySQL / XAMPP) ─────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sih26044_db
DB_USERNAME=root
DB_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── AI Service (Phase 3 – optional, system works without it) ─────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
